# Local Docker ports
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432

# PostgreSQL defaults used by docker-compose
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
DATABASE_URL=postgresql+psycopg://marketplace:marketplace@db:5432/marketplace

# App
ENVIRONMENT=development
COLLECTOR_PROVIDER=mock
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI scoring (optional for local development)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_NOTIFY_THRESHOLD=80

# WhatsApp Cloud API (optional for local development)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
META_GRAPH_VERSION=v23.0
